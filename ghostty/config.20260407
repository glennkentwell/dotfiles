# Config generated by Ghostty Config

keybind = shift+PageUp=scroll_page_up
keybind = shift+PageDown=scroll_page_down
keybind = cmd+shift+f=write_scrollback_file:open
macos-icon = retro
macos-icon-frame = beige
macos-icon-ghost-color = #564080

theme = Ayu Mirage

window-height = 50 
window-width = 120
# window-position-y = 1
# window-position-x = 1

font-family = CodeNewRoman Nerd Font Mono
